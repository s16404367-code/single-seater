{
  "name": "apex-gp",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-test.mjs",
    "check": "npm run format:check && npm run test && npm run build && npm run verify:build",
    "verify:build": "node scripts/verify-build.mjs",
    "test:accessibility": "node scripts/accessibility-test.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" vite.config.ts",
    "test:release": "node scripts/release-test.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^141.0.0",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.4"
  }
}
